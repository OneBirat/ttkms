# Copy to .env.local (ignored by git) and adjust. Next.js loads .env.local
# before next.config.ts is evaluated, so both variables are honoured by
# `npm run dev` and `npm run build`/`npm start`.

# Origin of the FastAPI backend. /api/*, /health and /core/export-demo.* are
# proxied there by the Next.js server (see next.config.ts), so the browser only
# ever talks to this app and the ttk_session cookie stays same-origin.
# Rewrites are fixed when the server starts (dev) or at `npm run build`.
API_URL=http://localhost:8000

# Port for `npm run dev` / `npm start` (`next` reads PORT; `--port` overrides).
# Worktrees: use 3001-3004 with API_URL pointing at that worktree's backend
# (8001-8004).
PORT=3000

# Nepali date picker enhancement for <BsDateInput>. Leave unset until the
# vendor files exist as web/public/vendor/nepali.datepicker.v4.min.js and
# web/public/vendor/nepali.datepicker.v4.min.css (copy them from
# static/vendor/). See lib/bsDatepicker.ts.
# NEXT_PUBLIC_BS_DATEPICKER=1
