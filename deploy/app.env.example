# TTK run-time configuration: /etc/ttk/app.env (root:ttk, mode 640).
#
# deploy/server-install.sh creates it from this file on the first run: it fills in SERVER_IP,
# DATABASE_URL (from /etc/ttk/db.env) and a random SECRET_KEY. It never overwrites an existing
# file, so edit /etc/ttk/app.env by hand afterwards and restart:
#   sudo systemctl restart ttk-api ttk-web
#
# Read by both systemd units (EnvironmentFile=) and by the deploy scripts (sourced by bash), so
# keep it to plain KEY=value lines: no quotes, no spaces around "=", no spaces in values.

# --- API (FastAPI, ttk-api.service) ---------------------------------------------------------

# "prod" turns off the API docs, refuses a weak SECRET_KEY, makes the session cookie Secure and
# makes seed-demo refuse to run. Never "dev" on the server.
APP_ENV=prod

# Signs the session cookie. At least 32 random characters; changing it signs everyone out.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=CHANGE_ME

# PostgreSQL, with the driver prefix the code needs (postgresql+asyncpg://). Same user, password,
# host, port and database as DATABASE_URL in /etc/ttk/db.env (which has no prefix).
DATABASE_URL=postgresql+asyncpg://ttk:CHANGE_ME@127.0.0.1:5432/ttk

# Employee photos and other uploads (ttk:ttk 750). Served only through the API, signed in.
MEDIA_DIR=/var/lib/ttk/uploads

# Feature modules to load, comma-separated, sidebar order: attendance, payroll, admin.
ENABLED_MODULES=attendance,payroll,admin

# Secure flag on the session cookie (HttpOnly and SameSite=Lax are always on). Leave it commented
# out: with APP_ENV=prod it is on. Only set false if you ever serve the app over plain http.
#SESSION_HTTPS_ONLY=true

# Optional session lifetimes (defaults shown).
#SESSION_MAX_AGE_DAYS=14
#SESSION_SHORT_MAX_AGE_HOURS=12

# Proxy headers (X-Forwarded-For/-Proto) are trusted from these addresses only: Caddy, same host.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Web (Next.js, ttk-web.service) ---------------------------------------------------------

# Where the Next.js server reaches the API for its own server-side requests (middleware.ts).
# The browser always calls the relative /api, which Caddy sends to the API.
API_INTERNAL_URL=http://127.0.0.1:8000

# --- Deploy scripts ---------------------------------------------------------------------------

# The server's public IP. The Caddyfile and the HTTPS certificate are made for it; the update
# script's health check uses it. To change it, edit this line and re-run server-install.sh.
SERVER_IP=1.2.3.4
