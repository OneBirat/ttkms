# Copy to .env in every worktree. Each worktree: own .venv, own ports, same database.
DATABASE_URL=postgresql+asyncpg://ttk:CHANGE_ME@localhost:5433/ttk
SECRET_KEY=CHANGE_ME
APP_PORT=8000
WEB_PORT=3000
APP_ENV=dev

# Feature modules to load, comma-separated (stock, attendance, payroll, admin). A module that is
# not listed is hidden everywhere: no /api/<name> routes, no sidebar section, no dashboard
# widgets, no migrations. Its code and database tables are left untouched.
# "stock" is paused (2026-10-24) - see README "Stock module (paused)" to turn it back on.
ENABLED_MODULES=attendance,payroll,admin

# Optional: lets `python -m app.cli seed` create the admin user without prompting.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=CHANGE_ME

# Optional: database used by `make test` (created and migrated by the tests themselves).
# Defaults to "<database>_test_<checkout dir>" on the same server, e.g. ttk_test_ttkms.
#TEST_DATABASE_URL=postgresql+asyncpg://ttk:CHANGE_ME@localhost:5433/ttk_test
